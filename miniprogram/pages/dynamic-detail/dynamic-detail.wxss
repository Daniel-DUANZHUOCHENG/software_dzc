.container {
  padding: 0 0 120rpx 0;
  background: #fff;
  min-height: 100vh;
}

/* 头部样式 */
.header {
  padding: 40rpx 30rpx;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.source {
  color: #3B82F6;
}

/* 内容样式 */
.content {
  padding: 30rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
}

.content rich-text {
  display: block;
}

/* 底部分享样式 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  width: 100%;
  height: 80rpx;
  background: #3B82F6;
  color: #fff;
  font-size: 32rpx;
  border-radius: 40rpx;
}

.share-btn image {
  width: 40rpx;
  height: 40rpx;
}

/* dynamic-detail.wxss */
.dynamic-detail {
  width: 100%;
  min-height: 100vh;
  background: #fff;
}

/* 导航栏样式 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  padding-top: 44px;
  background: #fff;
  display: flex;
  align-items: center;
  z-index: 100;
  border-bottom: 1rpx solid #eee;
}

.nav-left {
  position: absolute;
  left: 30rpx;
  display: flex;
  align-items: center;
}

.nav-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 内容区域样式 */
.content {
  position: relative;
  top:30px;
  padding: 180rpx 40rpx 40rpx;
}

.article {
  background: #fff;
}

.article-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
}

.article-content {
  font-size: 32rpx;
  line-height: 1.8;
  color: #333;
  text-align: justify;
}

/* 富文本样式 */
.article-content rich-text {
  display: block;
}

/* 添加段落样式 */
.article-content rich-text p {
  text-indent: 2em;  /* 设置首行缩进为2个字符 */
  margin-bottom: 1em;  /* 段落间距 */
}

.article-content rich-text strong {
  font-weight: bold;
  color: #222;
}

/* 滚动条样式 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}

/* 标题区域 */
.header-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.dynamic-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.4;
  margin-bottom: 20rpx;
}

.dynamic-meta {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #999;
}

.source {
  margin-right: 20rpx;
}

/* 内容区域 */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 6rpx solid #3a5cff;
}

.section-content {
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
}

/* 文件列表 */
.file-list {
  background: #f8f8f8;
  border-radius: 8rpx;
}

.file-item {
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 2rpx;
}

.file-item:last-child {
  margin-bottom: 0;
}

.file-name {
  font-size: 28rpx;
  color: #333;
}

/* 证书列表 */
.certificate-list {
  background: #f8f8f8;
  border-radius: 8rpx;
}

.certificate-item {
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: 8rpx;
  margin-bottom: 2rpx;
}

.certificate-item:last-child {
  margin-bottom: 0;
}

.certificate-name {
  font-size: 28rpx;
  color: #333;
}

/* 图片展示区域样式 */
.image-section {
  margin: 30rpx 0;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.content-image {
  width: 100%;
  height: 200rpx;
  border-radius: 8rpx;
}

/* 文件展示区域样式 */
.files-section {
  margin: 30rpx 0;
}

/* 证书展示区域样式 */
.certificate-section {
  margin: 30rpx 0;
} 