<view class="container">
  <view class="form-section">
    <view class="form-title">参会回执</view>
    
    <!-- 单位 -->
    <view class="form-item">
      <text class="required">*</text>
      <text class="label">单位</text>
      <input class="input" placeholder="请输入单位" value="{{form.company}}" bindinput="onInputChange" data-field="company" />
    </view>

    <!-- 姓名 -->
    <view class="form-item">
      <text class="required">*</text>
      <text class="label">姓名</text>
      <input class="input" placeholder="请输入姓名" value="{{form.name}}" bindinput="onInputChange" data-field="name" />
    </view>

    <!-- 性别 -->
    <view class="form-item">
      <text class="required">*</text>
      <text class="label">性别</text>
      <radio-group class="radio-group" bindchange="onGenderChange">
        <label class="radio-label" wx:for="{{genderOptions}}" wx:key="value">
          <radio value="{{item.value}}" checked="{{form.gender === item.value}}" />
          <text>{{item.label}}</text>
        </label>
      </radio-group>
    </view>

    <!-- 手机号码 -->
    <view class="form-item">
      <text class="required">*</text>
      <text class="label">手机号码</text>
      <input class="input" type="number" placeholder="请输入手机号码" value="{{form.phone}}" bindinput="onInputChange" data-field="phone" />
    </view>

    <!-- 电子邮箱 -->
    <view class="form-item">
      <text class="required">*</text>
      <text class="label">电子邮箱</text>
      <input class="input" type="text" placeholder="请输入电子邮箱" value="{{form.email}}" bindinput="onInputChange" data-field="email" />
    </view>

    <!-- 房型 -->
    <view class="form-item">
      <text class="required">*</text>
      <text class="label">房型</text>
      <radio-group class="radio-group" bindchange="onRoomTypeChange">
        <label class="radio-label" wx:for="{{roomTypes}}" wx:key="value">
          <radio value="{{item.value}}" checked="{{form.roomType === item.value}}" />
          <text>{{item.label}}</text>
        </label>
      </radio-group>
    </view>

    <!-- 到达方式 -->
    <view class="form-item">
      <text class="required">*</text>
      <text class="label">到达方式</text>
      <radio-group class="radio-group" bindchange="onArrivalMethodChange">
        <label class="radio-label" wx:for="{{arrivalMethods}}" wx:key="value">
          <radio value="{{item.value}}" checked="{{form.arrivalMethod === item.value}}" />
          <text>{{item.label}}</text>
        </label>
      </radio-group>
    </view>

    <!-- 到达车次/航班 -->
    <view class="form-item">
      <text class="label">到达车次/航班</text>
      <input class="input" placeholder="请输入到达车次/航班" value="{{form.arrivalNo}}" bindinput="onInputChange" data-field="arrivalNo" />
    </view>

    <!-- 到达时间 -->
    <view class="form-item">
      <text class="required">*</text>
      <text class="label">到达时间</text>
      <picker mode="date" value="{{form.arrivalDate}}" start="2023-08-01" end="2023-08-05" bindchange="onArrivalDateChange">
        <view class="picker">
          <text class="picker-text">{{form.arrivalDate || '请选择到达日期'}}</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
      <picker mode="time" value="{{form.arrivalTime}}" bindchange="onArrivalTimeChange">
        <view class="picker">
          <text class="picker-text">{{form.arrivalTime || '请选择到达时间'}}</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 返程方式 -->
    <view class="form-item">
      <text class="required">*</text>
      <text class="label">返程方式</text>
      <radio-group class="radio-group" bindchange="onDepartureMethodChange">
        <label class="radio-label" wx:for="{{arrivalMethods}}" wx:key="value">
          <radio value="{{item.value}}" checked="{{form.departureMethod === item.value}}" />
          <text>{{item.label}}</text>
        </label>
      </radio-group>
    </view>

    <!-- 返程车次/航班 -->
    <view class="form-item">
      <text class="label">返程车次/航班</text>
      <input class="input" placeholder="请输入返程车次/航班" value="{{form.departureNo}}" bindinput="onInputChange" data-field="departureNo" />
    </view>

    <!-- 返程时间 -->
    <view class="form-item">
      <text class="required">*</text>
      <text class="label">返程时间</text>
      <picker mode="date" value="{{form.departureDate}}" start="2023-08-01" end="2023-08-05" bindchange="onDepartureDateChange">
        <view class="picker">
          <text class="picker-text">{{form.departureDate || '请选择返程日期'}}</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
      <picker mode="time" value="{{form.departureTime}}" bindchange="onDepartureTimeChange">
        <view class="picker">
          <text class="picker-text">{{form.departureTime || '请选择返程时间'}}</text>
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>

    <!-- 备注 -->
    <view class="form-item">
      <text class="label">备注</text>
      <textarea class="textarea" placeholder="请输入备注信息" value="{{form.remarks}}" bindinput="onInputChange" data-field="remarks" />
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn" type="primary" bindtap="submitForm">提交报名</button>
  </view>
</view> 