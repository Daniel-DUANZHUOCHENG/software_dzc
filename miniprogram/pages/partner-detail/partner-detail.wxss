/* partner-detail.wxss */
.page {
  min-height: 100vh;
  background: #fff;
  padding: 32rpx;
}

.partner-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.partner-logo {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 24rpx;
  object-fit: contain;
}

.partner-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.partner-content {
  padding-top: 32rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.section-content {
  font-size: 28rpx;
  line-height: 1.8;
  color: #666;
  text-align: justify;
}

.cooperation-list {
  display: flex;
  flex-wrap: wrap;
  margin: -12rpx;
}

.cooperation-item {
  margin: 12rpx;
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
}

.item-text {
  font-size: 28rpx;
  color: #666;
}

.partner-detail {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 导航栏样式 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  padding-top: 44px;
  background: #fff;
  display: flex;
  align-items: center;
  z-index: 100;
  border-bottom: 1rpx solid #eee;
}

.nav-left {
  position: absolute;
  left: 30rpx;
  display: flex;
  align-items: center;
}

.nav-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.content {
  padding: 180rpx 30rpx 30rpx;
}

/* Logo区域样式 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
}

.partner-logo {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 20rpx;
}

.partner-name {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
  text-align: center;
}

.partner-name.clickable {
  color: #3a5ccc;
  cursor: pointer;
}

.website-hint {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.partner-name.clickable:active {
  opacity: 0.8;
}

.section {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background-color: #3a5ccc;
  border-radius: 3rpx;
}

.section-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.history-list {
  margin-top: 20rpx;
}

.history-item {
  margin-bottom: 30rpx;
}

.history-item:last-child {
  margin-bottom: 0;
}

.year {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 10rpx;
}

.events {
  padding-left: 20rpx;
}

.event {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  position: relative;
  padding-left: 20rpx;
  margin-bottom: 10rpx;
}

.event::before {
  content: '';
  position: absolute;
  left: 0;
  top: 16rpx;
  width: 8rpx;
  height: 8rpx;
  background-color: #666;
  border-radius: 50%;
}

.contact-info {
  font-size: 28rpx;
  color: #666;
}

.phone {
  margin-bottom: 20rpx;
}

.address-item {
  margin-bottom: 16rpx;
  display: flex;
}

.address-name {
  font-weight: 500;
  margin-right: 10rpx;
  white-space: nowrap;
}

.address-detail {
  flex: 1;
  line-height: 1.6;
}