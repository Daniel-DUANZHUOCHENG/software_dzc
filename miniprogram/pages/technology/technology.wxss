.technology {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 导航栏样式 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  padding-top: 44px;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  border-bottom: 1rpx solid #eee;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 搜索框样式 */
.search-box {
  position: fixed;
  top: calc(120rpx + 44px);
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  z-index: 99;
  border-bottom: 1rpx solid #eee;
}

.search-box {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 36rpx;
  padding: 16rpx 30rpx;
  margin: 20rpx 30rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 内容区域样式 */
.content {
  padding: calc(120rpx + 44px + 120rpx) 30rpx 30rpx;
}

/* 课程列表样式 */
.course-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.course-card {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.course-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.course-image {
  width: 100%;
  height: 200rpx;
  background: #eee;
}

.course-info {
  padding: 20rpx;
}

.course-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.course-provider {
  font-size: 24rpx;
  color: #666;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 技术工具列表样式 */
.tech-list {
  height: calc(100vh - 112rpx);
}

.tech-grid {
  padding: 20rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.tech-item {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tech-image {
  width: 100%;
  height: 200rpx;
  background: #f0f0f0;
}

.tech-info {
  padding: 20rpx;
}

.tech-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.tech-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
}

.tech-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
}

.provider {
  color: #3B82F6;
}

.version {
  color: #999;
}

/* 加载状态样式 */
.loading-status {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

/* 空状态样式 */
.empty-state {
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
  font-size: 28rpx;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

/* 视频弹窗样式 */
.video-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.8);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-container {
  width: 90%;
  background: #000;
  border-radius: 12rpx;
  overflow: hidden;
}

.video-container video {
  width: 100%;
  height: 400rpx;
}

.video-title {
  padding: 20rpx;
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.8);
}

.no-results {
  width: 100%;
  padding: 40rpx 0;
  text-align: center;
}

.no-results-text {
  color: #999;
  font-size: 28rpx;
} 