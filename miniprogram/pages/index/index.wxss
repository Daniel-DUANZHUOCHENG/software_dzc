/**index.wxss**/
page {
  background: #fff;
}

.page {
  min-height: 100vh;
  background: #fff;
}

/* 导航栏样式 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  padding-top: 44px;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  border-bottom: 1rpx solid #eee;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* Banner盒子 */
.banner-box {
  width: 100%;
  height: 450rpx;
  overflow: hidden;
  position: relative;
  top:120px;
  font-size: 0;
}

.banner-swiper {
  width: 100%;
  height: 100%;
}

.banner-bg {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  vertical-align: top;
}

/* 协会介绍盒子 */
.intro-box {
  padding: 48rpx 32rpx;
  background: #fff; 
  position: relative;
  top:120px;
}

.intro-header {
  margin-bottom: 24rpx;
}

.intro-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.intro-subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
}

.intro-content {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #666;
  text-align: justify;
}

/* 协会简介统计区块 */
.intro-stats {
  display: flex;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f0f0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #E53935;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 合作伙伴盒子 */
.partner-box {
  background: #fff;
  position: relative;
  top:120px;
}

.section-header {
  margin-bottom: 60rpx;
  padding: 0 32rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.partner-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
 
}

.partner-item {
  display: flex;
  justify-content: center;
  align-items: center;
}

.partner-logo {
  width: 190rpx;
  height: 190rpx;
  object-fit: contain;
}

/* 底部导航栏样式 */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #EEEEEE;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
}

