.container {
  padding: 0;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 搜索栏样式 */
.search-bar {
  position:relative;
  top: 60px;
  z-index: 100;
  padding: 20rpx 30rpx;
  background: #fff;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 80rpx 0 30rpx;
  font-size: 28rpx;
  color: #333;
}

.search-icon {
  position: absolute;
  right: 50rpx;
  width: 40rpx;
  height: 40rpx;
}

.search-icon image {
  width: 100%;
  height: 100%;
  opacity: 0.5;
}

/* 动态列表样式 */
.dynamic-list {
  height: 80px;
  position:relative;
  top: 60px;
}

.dynamic-item {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  gap: 20rpx;
}

.dynamic-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.dynamic-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dynamic-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.dynamic-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: 24rpx;
  color: #999;
}

.dynamic-image {
  width: 200rpx;
  height: 160rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* 加载状态样式 */
.loading-status {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
}

/* 空状态样式 */
.empty-state {
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #999;
  font-size: 28rpx;
}

.empty-state image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

/* dynamic.wxss */
.dynamic-page {
  min-height: 100vh;
  background: #f7f8fa;
}

/* 导航栏样式 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  padding-top: 44px;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  border-bottom: 1rpx solid #eee;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 搜索栏样式 */
.search-box {
  position: fixed;
  top: 120rpx;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  z-index: 99;
  border-bottom: 1rpx solid #eee;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #f7f8fa;
  border-radius: 36rpx;
  padding: 0 30rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #333;
}

.placeholder {
  color: #999;
}

/* 动态列表样式 */
.dynamic-list {
  margin-top: 232rpx;
  height: calc(100vh - 232rpx);
  box-sizing: border-box;
}

.list-container {
  padding: 20rpx 30rpx;
}

.dynamic-card {
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  transition: all 0.3s ease;
}

.dynamic-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.card-content {
  padding: 30rpx;
}

.dynamic-header {
  margin-bottom: 20rpx;
}

.dynamic-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
}

.dynamic-summary {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin: 16rpx 0 24rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.dynamic-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 24rpx;
}

.dynamic-source {
  color: #3a5cff;
  background: rgba(58, 92, 255, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.dynamic-date {
  color: #999;
} 