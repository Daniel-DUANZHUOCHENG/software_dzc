<view class="cooperation">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-title">合作</view>
  </view>

  <!-- 内容区域 -->
  <view class="content">
    <!-- 会议研讨 -->
    <view class="card" bindtap="goToMeetingDetail" data-type="meeting" data-id="1">
      <view class="card-title">会议研讨</view>
      <view class="card-desc">协会组织会员单位召开行业会议，研讨相关技术与行业发展。</view>
      <view class="card-info">
        <text class="date">2023.08.02</text>
        <text class="source">云南计计委会</text>
      </view>
    </view>

    <!-- 标准制定 -->
    <view class="card" bindtap="goToMeetingDetail" data-type="meeting" data-id="2">
      <view class="card-title">标准制定</view>
      <view class="card-desc">协会组织成员单位联合制定软件测试行业标准。</view>
    </view>

    <!-- 技术培训 -->
    <view class="card" bindtap="goToMeetingDetail" data-type="meeting" data-id="3">
      <view class="card-title">技术培训</view>
      <view class="card-desc">协会组织会员单位开展软件测试技术、软件造价评估等培训。</view>
    </view>

    <!-- 公益行动 -->
    <view class="card" bindtap="goToPublicWelfare">
      <view class="card-title">公益行动</view>
      <view class="card-desc">会员单位积极参与欠发达地区留守儿童公益活动。</view>
      <view class="card-info">
        <text class="source">云南故事</text>
      </view>
    </view>
  </view>
</view> 