.container {
  padding: 0;
  background: #f5f5f5;
  min-height: 100vh;
}

/* Banner样式 */
.banner {
  position: relative;
  width: 100%;
  height: 300rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-text {
  position: absolute;
  left: 40rpx;
  bottom: 40rpx;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.banner-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.banner-desc {
  font-size: 28rpx;
  opacity: 0.9;
}

/* 通用section样式 */
.section {
  margin: 30rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  background: #3B82F6;
  border-radius: 3rpx;
}

/* 合作方式样式 */
.cooperation-types {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.coop-item {
  background: #f8f9fa;
  padding: 30rpx;
  border-radius: 12rpx;
  text-align: center;
}

.coop-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.coop-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.coop-desc {
  font-size: 24rpx;
  color: #666;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 合作伙伴样式 */
.partners {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.partner-item {
  text-align: center;
}

.partner-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 10rpx;
}

.partner-info {
  text-align: center;
}

.partner-name {
  display: block;
  font-size: 24rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.partner-type {
  font-size: 20rpx;
  color: #666;
}

/* 联系我们样式 */
.contact-section {
  margin-bottom: 60rpx;
}

.contact-info {
  margin-bottom: 30rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.contact-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.contact-text {
  font-size: 28rpx;
  color: #333;
}

.contact-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #3B82F6;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.contact-btn::after {
  display: none;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 80%;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.5;
}

.modal-body {
  padding: 30rpx;
  max-height: calc(80vh - 200rpx);
  overflow-y: auto;
}

.modal-image {
  width: 100%;
  height: 300rpx;
  margin-bottom: 20rpx;
  border-radius: 8rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.modal-features {
  margin-top: 20rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.feature-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
}

.feature-text {
  font-size: 26rpx;
  color: #333;
}

.modal-footer {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #3B82F6;
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  border: none;
}

.modal-btn::after {
  display: none;
}

.cooperation {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 导航栏样式 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  padding-top: 44px;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  border-bottom: 1rpx solid #eee;
}

.nav-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 内容区域样式 */
.content {
  padding: calc(120rpx + 44px + 20rpx) 30rpx 30rpx;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: linear-gradient(135deg, #6bb6ff 0%, #4e85fd 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.card:nth-child(2) {
  background: linear-gradient(135deg, #6bb6ff 0%, #4e85fd 100%);
}

.card:nth-child(3) {
  background: linear-gradient(135deg, #6bb6ff 0%, #4e85fd 100%);
}

.card:nth-child(4) {
  background: linear-gradient(135deg, #ff7eb3 0%, #ff5c8d 100%);
}

.card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.card-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.card-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}

.card-info {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.date {
  margin-right: 20rpx;
}

.source {
  position: relative;
  padding-left: 20rpx;
}

.source::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 24rpx;
  background: rgba(255, 255, 255, 0.3);
} 