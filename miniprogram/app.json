{
  "pages": [
    "pages/index/index",
    "pages/technology/technology",
    "pages/course-detail/course-detail",
    "pages/dynamic/dynamic",
    "pages/dynamic-detail/dynamic-detail",
    "pages/cooperation/cooperation",
